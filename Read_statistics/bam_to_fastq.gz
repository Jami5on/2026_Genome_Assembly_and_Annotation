#!/bin/bash
#SBATCH --job-name=bam2fastq
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=your@email.com
#SBATCH --nodes=1-1
#SBATCH --ntasks-per-node=4
#SBATCH --mem=48gb
#SBATCH --time=00-06:00:00
#SBATCH --output=bam2fastq_%j.log
#SBATCH --chdir=/path/to/raw/bam

source /scratch/jr4253/miniconda3/etc/profile.d/conda.sh
conda activate assembly

samtools fastq NES739.hifi_reads.bam | gzip > NES739.hifi_reads.fastq.gz
